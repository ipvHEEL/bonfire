POSTGRES_DB=bonfire
POSTGRES_USER=bonfire
POSTGRES_PASSWORD=bonfire

# Ключ подписи токенов входа. Сгенерировать:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-change-me-in-the-env-file
# false — только если запускаете без https (например, для отладки)
COOKIE_SECURE=true

# Звонки (LiveKit). Секрет — не короче 32 символов
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=dev-only-livekit-secret-change-me-in-env
# Адрес этого компьютера в локальной сети (ipconfig). По нему
# другие устройства отправляют звук на медиасервер
LIVEKIT_NODE_IP=192.168.1.13
